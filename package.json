{
  "name": "bothy",
  "private": true,
  "version": "0.1.0",
  "description": "Agents, but accountable — ranked, evidence-backed winter access intelligence (Bothy / Winter Watch).",
  "workspaces": [
    "apps/agent",
    "apps/web"
  ],
  "scripts": {
    "prepare": "husky",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:local": "bash scripts/setup_db.sh",
    "seed": "npm -w @bothy/agent run seed",
    "dev:agent": "npm -w @bothy/agent run dev",
    "dev:web": "npm -w @bothy/web run dev",
    "dev": "concurrently -k -n agent,web -c cyan,yellow \"npm run dev:agent\" \"npm run dev:web\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "npm run seed && npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "ansi-regex": "6.2.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "typescript-eslint": "^8.19.0"
  }
}
