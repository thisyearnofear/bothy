# Production (nuncio-vultr): Traefik terminates TLS and forwards plain HTTP
# here, so this site is HTTP-only and Caddy never tries to obtain certificates.
http://{$BOTHY_DOMAIN:bothy.trustfall.xyz} {
	encode zstd gzip

	# The demo identity provider has no passwords, so its account picker is
	# invite-only. Token, JWKS and authorize endpoints stay open for the
	# browser redirect and the server-to-server code exchange.
	@gate path /idp/interaction/*
	basic_auth @gate {
		import /etc/caddy/invite
	}

	# Container names, not service names: Caddy also sits on the shared
	# `coolify` network, where other apps' `web`/`idp` aliases collide.
	handle /idp/* {
		reverse_proxy bothy-idp:9099
	}
	handle {
		reverse_proxy bothy-web:8080
	}
}
