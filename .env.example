# Bothy runtime configuration.
# Copy to `.env` and fill in. Never commit `.env`.

# --- Agent ---
# Postgres connection (local Homebrew Postgres by default; see scripts/setup_db.sh)
DATABASE_URL=postgres://bothy:bothy@localhost:5432/bothy

# Anthropic key enables the live LLM brain. Leave empty to use the
# deterministic scripted brain (demo-safe, no key needed).
ANTHROPIC_API_KEY=

# Override the default Claude model used for tool-calling.
BOTHY_MODEL=claude-sonnet-4-5

# Port the agent API listens on.
PORT=8787

# --- Web ---
# Where the frontend proxies /api requests (Next.js rewrite target).
AGENT_URL=http://localhost:8787