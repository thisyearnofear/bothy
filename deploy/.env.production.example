# Copy to deploy/.env.production on the VPS. Never commit the real file.
# The agent reaches PostGIS through the private `bothy-internal` Docker network.
DATABASE_URL=postgres://bothy:<password>@bothy-db:5432/bothy
PORT=8787

# Browser origin for direct agent calls; the Netlify /api rewrite keeps
# normal browser traffic same-origin.
WEB_ORIGIN=https://<your-site>.netlify.app
# Public web origin used in digest links (case pages). Set to the Netlify URL.
PUBLIC_APP_URL=https://<your-site>.netlify.app
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Watch-my-road digest (Resend free tier). Leave RESEND_API_KEY blank for
# log-only mode (notifications queue + audit, no email leaves the box).
RESEND_API_KEY=
DIGEST_FROM=Bothy <alerts@bothy.trustfall.xyz>
# Shared secret for POST /api/digest/send (cron / Coolify scheduled job).
DIGEST_TOKEN=

# Optional provider configuration. Leave blank to use the deterministic scripted agent.
BOTHY_LLM_PROVIDERS=qwen-hf,venice,openrouter,openai,ollama
BOTHY_LLM_MAX_TOKENS=1500
BOTHY_LLM_TIMEOUT=25000
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=venice-uncensored
VENICE_TIMEOUT=60000
# VENICE_RPM=20
# VENICE_BURST=6
QWEN_HF_URL=https://g9hnto0u7lvbu837.us-east-2.aws.endpoints.huggingface.cloud/v1
QWEN_HF_MODEL=Qwen/Qwen3.8-27B
QWEN_REASONING=low
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b
