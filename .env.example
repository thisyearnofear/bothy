# Bothy runtime configuration. Copy to `.env` and fill in. NEVER commit `.env`
# (`.gitignore` + `scripts/check-secrets.sh` refuse it).

# --- Database ----------------------------------------------------------------
# Default: a remote Postgres (Docker + PostGIS) reached over an SSH tunnel to
# localhost:5433 (start with: scripts/db-tunnel.sh). The DB is NOT exposed
# publicly - it binds to 127.0.0.1 on the server.
DATABASE_URL=postgres://bothy:bothy@localhost:5433/bothy
# For a fully local install instead: npm run db:local  ->  :5432
# DATABASE_URL=postgres://bothy:bothy@localhost:5432/bothy

# --- LLM provider chain -------------------------------------------------------
# Providers are tried in order; the first that works wins (its result is
# rate-limited and cached). If none respond, the agent falls back to its
# deterministic scripted brain (no key needed).
BOTHY_LLM_PROVIDERS=nebius,qwen-hf,venice,openrouter,openai,ollama
BOTHY_LLM_MAX_TOKENS=1500
BOTHY_LLM_TIMEOUT=25000

# Nebius Token Factory (opt-in CONNECTED/cloud mode, not offline).
# Copy the endpoint and verified NVIDIA model ID from the current catalogue.
# All three values are required. No live/eligible integration is claimed yet.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=
NEBIUS_TIMEOUT=25000
# NEBIUS_RPM=20
# NEBIUS_BURST=4

# Venice AI (optional - set a dedicated VENICE_API_KEY; never commit it)
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=venice-uncensored
VENICE_TIMEOUT=60000
# VENICE_RPM=20
# VENICE_BURST=6

# Qwen3.8-27B - free public Hugging Face endpoint, OpenAI-compatible, no key.
QWEN_HF_URL=https://g9hnto0u7lvbu837.us-east-2.aws.endpoints.huggingface.cloud/v1
QWEN_HF_MODEL=Qwen/Qwen3.8-27B
QWEN_REASONING=low            # none | low | medium | high | xhigh (dial thinking)
# QWEN_HF_RPM=24
# QWEN_HF_BURST=12

# OpenRouter free tier (optional - set the key to enable)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Any OpenAI-compatible endpoint (vLLM, Groq, Together, local proxy, ...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (optional - set OLLAMA_BASE_URL to enable)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b

# --- Agent / web ---------------------------------------------------------
PORT=8787
# Set 127.0.0.1 for local-only API smoke tests; containers use 0.0.0.0.
AGENT_HOST=0.0.0.0
AGENT_URL=http://localhost:8787
# Browser origin permitted to call the agent directly; set this for deployment.
WEB_ORIGIN=http://localhost:3000
# Public web origin used in digest links (case pages). Set for deployment.
PUBLIC_WEB_URL=http://localhost:3000
# Agent URL for Next.js rewrite. Local: http://localhost:8787
# Fly.io/VPS internal network: http://bothy-agent.internal:8787
AGENT_URL=http://localhost:8787

# --- OIDC review adapter (all blank = approval/simulation disabled) ------------
# Use HTTPS issuer/JWKS URLs and a dedicated API access-token audience, not
# the browser login client ID. RS256/ES256 only; exp/iat/sub are required.
# Roles come from this server-side subject allowlist, never token/body roles.
# Obtain API access tokens through an approved SSO client/session bridge.
# Do not paste tokens into the UI, store them in localStorage, or log them.
BOTHY_OIDC_ISSUER=
BOTHY_OIDC_AUDIENCE=
BOTHY_OIDC_JWKS_URL=
BOTHY_OIDC_PRINCIPALS=
# Example shape, fictitious subjects only:
# BOTHY_OIDC_PRINCIPALS='{"analyst-sub":["analyst"],"reviewer-sub":["reviewer"],"owner-sub":["action-owner"]}'

# --- Digest (watch-my-road) ----------------------------------------------------
# Resend free tier (or leave blank for log-only queue mode in dev).
RESEND_API_KEY=
DIGEST_FROM=Bothy <alerts@bothy.trustfall.xyz>
DIGEST_TOKEN=
PUBLIC_APP_URL=http://localhost:3000

# --- Live weather context ----------------------------------------------------
# No key required for Open-Meteo's non-commercial public API.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast