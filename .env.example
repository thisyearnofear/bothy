# Bothy runtime configuration. Copy to `.env` and fill in. NEVER commit `.env`
# (`.gitignore` + `scripts/check-secrets.sh` refuse it).

# --- Database ----------------------------------------------------------------
# Default: a remote Postgres (Docker + PostGIS) reached over an SSH tunnel to
# localhost:5433 (start with: scripts/db-tunnel.sh). The DB is NOT exposed
# publicly - it binds to 127.0.0.1 on the server.
DATABASE_URL=postgres://bothy:bothy@localhost:5433/bothy
# For a fully local install instead: npm run db:local  ->  :5432
# DATABASE_URL=postgres://bothy:bothy@localhost:5432/bothy

# --- LLM provider chain -------------------------------------------------------
# Providers are tried in order; the first that works wins (its result is
# rate-limited and cached). If none respond, the agent falls back to its
# deterministic scripted brain (no key needed).
BOTHY_LLM_PROVIDERS=qwen-hf,openrouter,openai,ollama
BOTHY_LLM_MAX_TOKENS=1500
BOTHY_LLM_TIMEOUT=25000

# Qwen3.8-27B - free public Hugging Face endpoint, OpenAI-compatible, no key.
QWEN_HF_URL=https://g9hnto0u7lvbu837.us-east-2.aws.endpoints.huggingface.cloud/v1
QWEN_HF_MODEL=Qwen/Qwen3.8-27B
QWEN_REASONING=low            # none | low | medium | high | xhigh (dial thinking)
# QWEN_HF_RPM=24
# QWEN_HF_BURST=12

# OpenRouter free tier (optional - set the key to enable)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Any OpenAI-compatible endpoint (vLLM, Groq, Together, local proxy, ...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (optional - set OLLAMA_BASE_URL to enable)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b

# --- Agent / web ---------------------------------------------------------
PORT=8787
AGENT_URL=http://localhost:8787
# Browser origin permitted to call the agent directly; set this for deployment.
WEB_ORIGIN=http://localhost:3000