# Copy to deploy/.env.sso on the server and fill with generated secrets
# (openssl rand -hex 32). Never commit the real file.
BOTHY_OIDC_ISSUER=https://bothy.example.com/idp
BOTHY_OIDC_JWKS_URL=https://bothy.example.com/idp/jwks
BOTHY_OIDC_AUDIENCE=bothy-demo-api
BOTHY_OIDC_PRINCIPALS='{"analyst":["analyst"],"reviewer":["reviewer"],"owner":["action-owner"]}'
BOTHY_SSO_AUTHORIZE_URL=https://bothy.example.com/idp/auth
BOTHY_SSO_TOKEN_URL=https://bothy.example.com/idp/token
BOTHY_SSO_CLIENT_ID=bothy-demo-web
BOTHY_SSO_CLIENT_SECRET=
BOTHY_SSO_AUDIENCE=bothy-demo-api
BOTHY_SSO_RESOURCE=https://bothy.example.com/api
BOTHY_SSO_REDIRECT_URI=https://bothy.example.com/api/auth/callback
BOTHY_SESSION_SECRET=
BOTHY_IDP_COOKIE_KEY=
